<?xml version="1.0" encoding="utf-8"?>
<!--
    Autorise le trafic HTTP en clair, uniquement utile en développement pour
    joindre le serveur Django local (10.0.2.2 sur l'émulateur, ou l'IP du
    poste sur le réseau local pour un appareil physique).
    À retirer / restreindre avant toute mise en production avec un vrai
    serveur HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
